# Скопируй этот файл в .env и впиши свои значения (файл .env в git не попадёт).
# Нужно только для Telegram-уведомлений. Без них скрапер тоже работает —
# просто печатает новые вакансии в консоль.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой chat_id (узнать: напиши боту, затем открой
# https://api.telegram.org/bot<ТОКЕН>/getUpdates и найди "chat":{"id":...})
TELEGRAM_CHAT_ID=
